# deploy bump 2025-11-18
# Orchestrator Environment Variables (copy to .env on deploy)

# Supabase (server)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWKS_URL=

# Auth
SUPERADMIN_EMAIL=

# CORS
WEB_ORIGIN=

# Cron protection
CRON_TOKEN=
CRON_ENABLED=false
# Optional: minimum minutes between successful cron enqueues
CRON_MIN_INTERVAL_MINUTES=0
# Cleanup retention in days (for /cron/cleanup)
CLEANUP_KEEP_DAYS=14

# Purchase AI automation (runs comparison + AI analysis on schedule)
PURCHASE_AI_ENABLED=false

# Railway provides PORT automatically
# PORT=
